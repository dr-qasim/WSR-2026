<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="PlantProduction.Desktop.TechnologyCardWindow"
        Width="960"
        Height="740"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Title="Карточка технологической карты">
    <Grid RowDefinitions="Auto,220,*" Margin="12" RowSpacing="12">
        <TextBlock x:Name="TitleTextBlock"
                   FontSize="24"
                   FontWeight="Bold"
                   Text="Карточка технологической карты" />

        <TextBox x:Name="HeaderTextBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Шаги и параметры" />
            <TextBox x:Name="StepsTextBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
