<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PlantProduction</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PlantProduction.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="container shell">
            <a class="brand" asp-area="" asp-page="/Index">PlantProduction</a>
            <span class="caption">web-клиент аппаратчика</span>
        </div>
    </header>

    <div class="container shell">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container shell">
            <span>2026</span>
            <span>PlantProduction</span>
            <span>приоритет: рабочие сценарии, а не лишняя архитектура</span>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
