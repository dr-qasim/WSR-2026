@page
@model IndexModel
@{
    ViewData["Title"] = "Модуль аппаратчика";
}

<section class="hero">
    <div class="hero__content">
        <p class="eyebrow">PlantProduction Web</p>
        <h1>Модуль аппаратчика</h1>
        <p class="lead">
            Веб-интерфейс для операторской работы по активным партиям, шагам производства,
            вводу факта, отклонениям и телеметрии.
        </p>
    </div>
</section>

<section class="cards">
    <article class="card">
        <h2>Что делаем в первую очередь</h2>
        <ul>
            <li>авторизация</li>
            <li>активные партии</li>
            <li>программа партии</li>
            <li>старт и завершение шагов</li>
            <li>ввод фактических значений</li>
        </ul>
    </article>

    <article class="card">
        <h2>Что добавим после</h2>
        <ul>
            <li>отклонения и причины</li>
            <li>журнал партии</li>
            <li>телеметрия оборудования</li>
            <li>сигналы и уведомления</li>
            <li>оперативные отчеты</li>
        </ul>
    </article>
</section>
