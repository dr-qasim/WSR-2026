<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="PlantProduction.Desktop.Laboratory.MainWindow"
        Width="1400"
        Height="850"
        MinWidth="1200"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Title="Лаборатория">
  <Grid RowDefinitions="Auto,*" Margin="16">
    <Border Padding="12"
            BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
        <TextBlock x:Name="HeaderTextBlock"
                   FontSize="22"
                   FontWeight="Bold"
                   Text="Лаборатория" />
        <Button Grid.Column="1"
                Content="Обновить всё"
                Click="RefreshAllButton_OnClick" />
        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Text="" />
      </Grid>
    </Border>

    <TabControl Grid.Row="1"
                Margin="0,12,0,0">
      <TabItem Header="Партии сырья">
        <Grid Margin="8"
              ColumnDefinitions="1.3*,1*"
              ColumnSpacing="12"
              RowDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <Button Content="Загрузить партии"
                    Click="LoadLotsButton_OnClick" />
            <TextBox x:Name="LotSearchTextBox"
                     Width="260"
                     Watermark="Поиск по номеру или сырью" />
            <Button Content="Найти"
                    Click="SearchLotsButton_OnClick" />
            <Button Content="Создать испытание по партии"
                    Click="CreateTestFromLotButton_OnClick" />
          </StackPanel>

          <DataGrid x:Name="LotsGrid"
                    Grid.Row="1"
                    AutoGenerateColumns="True"
                    SelectionChanged="LotsGrid_OnSelectionChanged" />

          <Border Grid.RowSpan="2"
                  Grid.Column="1"
                  Padding="12"
                  BorderThickness="1">
            <StackPanel Spacing="8">
              <TextBlock FontSize="18"
                         FontWeight="SemiBold"
                         Text="Карточка партии сырья" />
              <TextBox x:Name="LotDetailTextBox"
                       MinHeight="500"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       Text="Выберите партию в таблице слева." />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Испытания">
        <Grid Margin="8"
              ColumnDefinitions="1.2*,1*"
              ColumnSpacing="12"
              RowDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <Button Content="Загрузить испытания"
                    Click="LoadTestsButton_OnClick" />
            <Button Content="Старт испытания"
                    Click="StartTestButton_OnClick" />
            <Button Content="Сохранить результаты"
                    Click="SaveResultsButton_OnClick" />
            <Button Content="Завершить испытание"
                    Click="CompleteTestButton_OnClick" />
          </StackPanel>

          <Grid Grid.Row="1"
                RowDefinitions="1.2*,*"
                RowSpacing="12">
            <DataGrid x:Name="TestsGrid"
                      AutoGenerateColumns="True"
                      SelectionChanged="TestsGrid_OnSelectionChanged" />
            <TextBox x:Name="TestDetailTextBox"
                     Grid.Row="1"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Text="Выберите испытание." />
          </Grid>

          <ScrollViewer Grid.RowSpan="2"
                        Grid.Column="1">
            <StackPanel Spacing="10">
              <TextBlock FontSize="18"
                         FontWeight="SemiBold"
                         Text="Создание испытания" />
              <Button Content="Загрузить спецификации"
                      Click="LoadSpecificationsButton_OnClick" />
              <DataGrid x:Name="SpecificationsGrid"
                        Height="180"
                        AutoGenerateColumns="True"
                        SelectionChanged="SpecificationsGrid_OnSelectionChanged" />
              <TextBlock Text="Вид контроля" />
              <ComboBox x:Name="SubjectTypeComboBox"
                        SelectedIndex="0">
                <ComboBoxItem Content="Входной контроль сырья"
                              Tag="1" />
                <ComboBoxItem Content="Контроль производственной партии"
                              Tag="2" />
              </ComboBox>
              <TextBlock Text="Партия сырья" />
              <TextBox x:Name="RawMaterialLotIdTextBox"
                       Watermark="Выберите партию слева или введите номер" />
              <TextBlock Text="Производственная партия" />
              <TextBox x:Name="ProductionBatchIdTextBox"
                       Watermark="Введите номер партии" />
              <TextBlock Text="Спецификация" />
              <TextBox x:Name="SpecificationIdTextBox"
                       Watermark="Выберите спецификацию из списка" />
              <TextBlock Text="Вид испытания" />
              <TextBox x:Name="TestKindTextBox"
                       Watermark="Например: входной контроль"
                       Text="Входной контроль" />
              <TextBlock Text="Срочность" />
              <ComboBox x:Name="PriorityComboBox"
                        SelectedIndex="0">
                <ComboBoxItem Content="Обычная"
                              Tag="1" />
                <ComboBoxItem Content="Повышенная"
                              Tag="2" />
                <ComboBoxItem Content="Срочная"
                              Tag="3" />
              </ComboBox>
              <TextBox x:Name="CreateCommentTextBox"
                       Watermark="Комментарий" />
              <Button Content="Создать испытание"
                      Click="CreateTestButton_OnClick" />

              <TextBlock FontSize="18"
                         FontWeight="SemiBold"
                         Margin="0,12,0,0"
                         Text="Результаты" />
              <TextBox x:Name="ResultsTextBox"
                       MinHeight="150"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       Watermark="Результаты" />
              <TextBox x:Name="ResultSummaryTextBox"
                       Watermark="Итог испытания" />

              <TextBlock FontSize="18"
                         FontWeight="SemiBold"
                         Margin="0,12,0,0"
                         Text="Решение по качеству" />
              <TextBlock Text="Решение" />
              <ComboBox x:Name="DecisionStatusComboBox"
                        SelectedIndex="0">
                <ComboBoxItem Content="Разрешить"
                              Tag="1" />
                <ComboBoxItem Content="Заблокировать"
                              Tag="2" />
              </ComboBox>
              <TextBox x:Name="DecisionCommentTextBox"
                       Watermark="Комментарий"
                       Text="Решение принято" />
              <TextBox x:Name="DecisionBlockReasonTextBox"
                       Watermark="Причина блокировки" />
              <Button Content="Принять решение"
                      Click="CreateDecisionButton_OnClick" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="Решения и история">
        <Grid Margin="8"
              RowDefinitions="Auto,1.2*,*"
              RowSpacing="12">
          <Button HorizontalAlignment="Left"
                  Content="Загрузить решения"
                  Click="LoadDecisionsButton_OnClick" />
          <DataGrid x:Name="DecisionsGrid"
                    Grid.Row="1"
                    AutoGenerateColumns="True" />
          <TextBox x:Name="HistoryTextBox"
                   Grid.Row="2"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   Text="" />
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
